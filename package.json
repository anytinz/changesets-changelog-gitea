{
  "name": "changesets-changelog-gitea",
  "version": "0.3.0",
  "description": "A changelog entry generator for Gitea that links to commits, PRs and users",
  "repository": {
    "type": "git",
    "url": "https://github.com/anytinz/changesets-changelog-gitea.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "gitea:types": "node scripts/generate-gitea-schema.js",
    "lint": "eslint --cache --concurrency 8 .",
    "prepare": "pnpm gitea:types",
    "test": "vitest run",
    "test:type": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@anytinz/eslint-config": "2.7.1",
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@changesets/types": "7.0.0",
    "@types/node": "22.20.1",
    "better-typescript-lib": "2.12.0",
    "changeset": "0.2.6",
    "eslint": "9.39.5",
    "openapi-typescript": "7.13.0",
    "tsdown": "0.22.14",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@12.1.0",
  "engines": {
    "node": "^22.11 || ^24.11 || >=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.11.0",
      "onFail": "download"
    }
  }
}
